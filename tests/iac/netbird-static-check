#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
root="$repo_root/infra/netbird"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

export TF_DATA_DIR="$work/data"
export TF_VAR_state_encryption_passphrase=dummy-state-passphrase-at-least-32-characters
export NB_PAT=dummy-token
export NB_MANAGEMENT_URL=https://api.netbird.io

tofu -chdir="$root" fmt -check
tofu -chdir="$root" init \
  -input=false \
  -lockfile=readonly \
  -backend-config="path=$work/state.tfstate" >/dev/null
tofu -chdir="$root" validate >/dev/null
tofu -chdir="$root" plan \
  -refresh=false \
  -input=false \
  -lock=false \
  -out="$work/plan" >/dev/null

tofu -chdir="$root" show -json "$work/plan" |
  jq -e '
    [.resource_changes[].type] | sort ==
    ["netbird_group", "netbird_network", "netbird_network_resource"]
  ' >/dev/null

cat >"$work/wrong-estate.yaml" <<'YAML'
north-york:
  name: North York
  networks:
    lan:
      cidr: 192.0.2.0/24
YAML

if tofu -chdir="$root" plan \
  -refresh=false \
  -input=false \
  -lock=false \
  -var="estate_file=$work/wrong-estate.yaml" >/dev/null 2>&1; then
  printf 'mismatched North York LAN boundary was accepted\n' >&2
  exit 1
fi

if git -C "$repo_root" ls-files | grep -Eq '(^|/)(\.terraform/|.*\.tfstate(\..*)?$|.*\.tfplan$)'; then
  printf 'tracked OpenTofu operational data found\n' >&2
  exit 1
fi

git -C "$repo_root" check-ignore -q infra/netbird/.terraform/example
printf 'NetBird static check passed\n'
