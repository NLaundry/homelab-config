#!/usr/bin/expect -f

set timeout 20
if {$argc != 4} {
  puts stderr "usage: mount-smb-with-auth.exp AUTH_FILE SERVER SHARE MOUNTPOINT"
  exit 2
}

lassign $argv auth_file server share mountpoint
set username ""
set password ""
set domain "WORKGROUP"
set handle [open $auth_file r]
while {[gets $handle line] >= 0} {
  if {[regexp -nocase {^[[:space:]]*username[[:space:]]*=[[:space:]]*(.+)$} $line -> value]} {
    set username [string trim $value]
  } elseif {[regexp -nocase {^[[:space:]]*password[[:space:]]*=[[:space:]]*(.+)$} $line -> value]} {
    set password [string trim $value]
  } elseif {[regexp -nocase {^[[:space:]]*domain[[:space:]]*=[[:space:]]*(.+)$} $line -> value]} {
    set domain [string trim $value]
  }
}
close $handle

if {![regexp {^[A-Za-z0-9._-]+$} $username] || ![regexp {^[A-Za-z0-9._-]+$} $domain] || $password eq ""} {
  puts stderr "authentication file has invalid or missing fields"
  exit 2
}

set url "//$domain;$username@$server/$share"
spawn -noecho /sbin/mount_smbfs -o nobrowse,soft,nostreams -s $url $mountpoint
expect {
  -nocase -re {password.*:} {
    log_user 0
    send -- "$password\r"
    log_user 1
    exp_continue
  }
  eof {
    set result [wait]
    set password ""
    exit [lindex $result 3]
  }
  timeout {
    set password ""
    puts stderr "SMB mount timed out for $server/$share"
    exit 124
  }
}
