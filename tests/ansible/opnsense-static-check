#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
playbook="$repo_root/ansible/playbooks/opnsense-netbird-enrollment.yml"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

ansible-galaxy collection install \
  -r "$repo_root/ansible/requirements.yml" \
  -p "$work/collections" >/dev/null 2>&1

export ANSIBLE_COLLECTIONS_PATH="$work/collections"
export OPNSENSE_URL=https://OPNsense.localdomain
export OPNSENSE_API_KEY=dummy-key
export OPNSENSE_API_SECRET=dummy-secret

ansible-playbook --syntax-check \
  -i "$repo_root/ansible/inventory.yml" \
  "$playbook" >/dev/null

python3 - "$playbook" <<'PY'
import sys, yaml
play = yaml.safe_load(open(sys.argv[1], encoding="utf-8"))[0]
assert play.get("no_log") is True
posts = []
for task in play["tasks"]:
    raw = task.get("oxlorg.opnsense.raw")
    if raw and raw.get("action", "get") == "post":
        posts.append(task)
        assert task.get("when") == "opnsense_netbird_prepare | bool"
assert [task["oxlorg.opnsense.raw"]["url"] for task in posts] == [
    "netbird/settings/set",
    "netbird/settings/sync",
]
settings = posts[0]["oxlorg.opnsense.raw"]["data"]["settings"]
assert settings["dns"]["enable"] == "0"
assert settings["ssh"]["enable"] == "0"
assert settings["routing"] == {
    "accessLan": "0",
    "acceptClientRoutes": "0",
    "acceptServerRoutes": "0",
}
PY

if grep -Eq 'NETBIRD_SETUP_KEY|netbird/authentication/(set|up)|url:[[:space:]]+(interfaces|firewall)/|netbird_network_router|[Ss]carborough' "$playbook"; then
  printf 'out-of-scope interface, firewall, routing, or site declaration found\n' >&2
  exit 1
fi

if grep -R -i -E 'setup[_ -]?key' "$repo_root/secrets" >/dev/null; then
  printf 'setup-key field found in managed secret storage\n' >&2
  exit 1
fi

printf 'OPNsense NetBird static check passed\n'
